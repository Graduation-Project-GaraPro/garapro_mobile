<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bottom_sheet_background">

    <!-- Handle Bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="#E0E0E0"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/tvCompletedTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SERVICE COMPLETED"
            android:textColor="#888888"
            android:textSize="12sp"
            android:letterSpacing="0.05"
            android:textStyle="bold"
            android:textAllCaps="true" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/tvCompletedTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15 min"
                android:textColor="@android:color/black"
                android:textSize="24sp"
                android:textStyle="bold" />

            <View
                android:layout_width="4dp"
                android:layout_height="4dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="#E0E0E0"
                android:layout_marginHorizontal="12dp"/>

            <TextView
                android:id="@+id/tvCompletedDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3.5 km"
                android:textColor="@android:color/black"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvCompletedSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thank you for using our service"
            android:textColor="#6B7280"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            android:visibility="visible"/>

    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:cardCornerRadius="30dp"
        app:strokeWidth="0dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@android:color/transparent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="8dp">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/ivTechAvatar"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_tech"
                app:civ_border_width="0dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="16dp">

                <TextView
                    android:id="@+id/tvTechNameCompleted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Technician"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="@android:color/black"/>

                <TextView
                    android:id="@+id/tvTechPhoneCompleted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="14sp"
                    android:textColor="#6B7280"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnCallTechCompleted"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Call"
                android:textAllCaps="false"
                android:backgroundTint="#FFEB3B"
                android:textColor="@android:color/black"
                android:textStyle="bold"
                app:icon="@drawable/ic_phone"
                app:iconTint="@android:color/black"
                app:cornerRadius="24dp"
                android:paddingHorizontal="24dp"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnFinish"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:text="Back to Home"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:textSize="16sp"
        app:cornerRadius="12dp"
        app:backgroundTint="@android:color/black"/>

</LinearLayout>